# Razorpay Test Mode credentials. Never commit a real .env.
# Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard -> Settings -> Webhooks -> the secret you set when creating the webhook
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Optional. Without it, raze starts an embedded PostgreSQL under raze/.pgdata.
# Your application's database. Required by the agent (`raze agent`): the question
# it answers is whether YOUR order state is correct, and that lives here. Leave
# it unset and the CLI starts its own embedded Postgres for demos instead.
# DATABASE_URL=postgres://user:pass@localhost:5432/your_database

# The table holding your orders. `raze infer` finds it if you are not sure.
# RAZE_ORDERS_TABLE=orders

# Optional. Only 'raze explain' uses this; every other command runs without it.
# ANTHROPIC_API_KEY=sk-ant-...
